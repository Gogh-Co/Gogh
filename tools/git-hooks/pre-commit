#!/usr/bin/env bash
# Refuses to commit anything under the CI-generated output paths: data/,
# installs/, gogh.sh, tools/run.txt. Those are written by the generate/
# pipeline in CI (.github/workflows/generate-on-push.yml) -- a hand-made
# commit there just gets overwritten (or conflicts) on the next push.
#
# Only enabled locally, only for humans: this only runs for commits made in
# a clone that has this hooks path configured (see setup below), and CI's own
# regenerate-and-push step runs in a fresh checkout that never has it set, so
# it's unaffected.
#
# One-time setup, once per clone:
#   git config core.hooksPath tools/git-hooks
#
# To preview generated output locally without committing it, use
# tools/generate-run_local.sh instead.

set -euo pipefail

blocked_prefixes=("data/" "installs/")
blocked_files=("gogh.sh" "tools/run.txt")

violations=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  for prefix in "${blocked_prefixes[@]}"; do
    case "$f" in
      "$prefix"*) violations+=("$f") ;;
    esac
  done
  for blocked in "${blocked_files[@]}"; do
    [ "$f" = "$blocked" ] && violations+=("$f")
  done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "${#violations[@]}" -gt 0 ]; then
  echo "error: commit blocked -- these files are generated by CI, never commit them by hand:" >&2
  printf '  %s\n' "${violations[@]}" >&2
  echo "Use tools/generate-run_local.sh to preview generated output without committing it." >&2
  exit 1
fi
